rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny rules
    match /{document=**} {
      allow read, write: if false;
    }

    // Stalls collection rules: Everyone can read; anyone can create or modify to support likes/feedbacks
    match /stalls/{stallId} {
      allow read, write: if true;
    }

    // Announcements collection rules: Everyone can read; anyone can post/broadcast updates
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Registrations collection rules: Everyone can read and self-register for any slot
    match /registrations/{registrationId} {
      allow read, write: if true;
    }

    // Users profiles collection rules
    match /users/{uid} {
      allow read, write: if true;
    }

    // SearchHistory collection rules
    match /searchHistory/{searchId} {
      allow read, write: if true;
    }
  }
}
